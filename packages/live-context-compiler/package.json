{
  "name": "live-context-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/public.d.ts",
      "import": "./dist/src/public.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "index": "tsx src/cli.ts index",
    "slice": "tsx src/cli.ts slice",
    "watch": "tsx src/cli.ts watch",
    "bench": "tsx src/benchmark.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "fast-glob": "^3.3.3",
    "minimist": "^1.2.8",
    "tree-sitter-wasms": "0.1.13",
    "typescript": "^5.8.2",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "tsx": "^4.19.3",
    "vitest": "^3.0.8",
    "@types/node": "^22.15.0"
  }
}
